# ---------------------------------------------------------------------------
# Chat Pilot SaaS - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Public origin of this SaaS install. Used for links in emails and CORS checks.
APP_URL=http://localhost:4000

# Database (SQLite file path; ':memory:' is used by the test suite)
DATABASE_FILE=./data/chat-pilot.sqlite

# Secrets -------------------------------------------------------------------
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts customer AI provider credentials at rest (AES-256-GCM).
ENCRYPTION_KEY=
# Signs portal session cookies (HMAC-SHA256).
SESSION_SECRET=
# Peppers the HMAC used to index/verify Chat Pilot Site API keys.
SITE_KEY_PEPPER=

# Security ------------------------------------------------------------------
# Force HTTPS redirects + Secure cookies. Must be true in production.
FORCE_HTTPS=false
# Trust X-Forwarded-* headers (set to true only behind a trusted reverse proxy).
TRUST_PROXY=false

# Rate limiting (per window)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_15MIN=10
RATE_LIMIT_API_PER_MINUTE=120

# Uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIR=./data/uploads

# Outbound AI provider calls
PROVIDER_TIMEOUT_MS=20000

# Email (notifications). When SMTP is not configured, notifications are
# recorded in the notifications table and logged, never lost.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@chatpilot.local

# Bootstrap super admin (created by `npm run seed` only if absent)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
