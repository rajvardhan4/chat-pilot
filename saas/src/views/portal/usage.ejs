<%- include('../partials/head') %>
<%- include('../partials/portal-header') %>
<%- include('../partials/account-tabs') %>

<div class="cp-card">
  <h2 class="cp-card-title">Usage <small><%= usage.period %></small></h2>
  <div class="cp-kpi-grid">
    <div class="cp-kpi-card"><div class="cp-kpi-icon">✉️</div><div><div class="cp-kpi-value"><%= usage.messages.toLocaleString() %></div><div class="cp-kpi-label">Messages</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">🤖</div><div><div class="cp-kpi-value"><%= usage.aiRequests.toLocaleString() %></div><div class="cp-kpi-label">AI Requests</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">📥</div><div><div class="cp-kpi-value"><%= usage.inputTokens.toLocaleString() %></div><div class="cp-kpi-label">Input Tokens</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">📤</div><div><div class="cp-kpi-value"><%= usage.outputTokens.toLocaleString() %></div><div class="cp-kpi-label">Output Tokens</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">💵</div><div><div class="cp-kpi-value">$<%= usage.estimatedCost.toFixed(4) %></div><div class="cp-kpi-label">Estimated Cost</div></div></div>
  </div>

  <% if (subscription) { %>
    <% const limit = Number(subscription.max_messages_month) || 0; %>
    <% if (limit > 0) { %>
      <div class="cp-mt">
        <p class="cp-help-text"><%= usage.messages.toLocaleString() %> of <%= limit.toLocaleString() %> messages used this month.</p>
        <div class="cp-bar"><div class="cp-bar-fill" style="width:<%= Math.min(100, Math.round((usage.messages / limit) * 100)) %>%"></div></div>
      </div>
    <% } %>
  <% } %>

  <p class="cp-help-text cp-mt">
    Estimated cost is Chat Pilot&rsquo;s own calculation from tracked tokens and a published rate table. It is not
    your provider&rsquo;s bill &mdash; check your provider dashboard for actual charges.
  </p>
</div>

<div class="cp-grid cp-grid-2">
  <div class="cp-card">
    <h3 class="cp-card-title">
      Monthly AI budget
      <% if (budget.configured) { %>
        <span class="cp-pill <%= budget.overBudget ? 'cp-pill-error' : (budget.alerting ? 'cp-pill-warning' : 'cp-pill-success') %>">
          <%= budget.percentUsed %>% used
        </span>
      <% } %>
    </h3>

    <% if (budget.configured) { %>
      <ul class="cp-inline-list">
        <li><span>Configured budget</span><span>$<%= budget.budget.toFixed(2) %></span></li>
        <li><span>Estimated used</span><span>$<%= budget.spent.toFixed(2) %></span></li>
        <li><span>Estimated remaining</span><span><strong>$<%= budget.remaining.toFixed(2) %></strong></span></li>
        <li><span>Alert threshold</span><span><%= budget.alertPercent %>%</span></li>
      </ul>
      <div class="cp-bar cp-mt">
        <div class="cp-bar-fill" style="width:<%= Math.min(100, Math.max(0, budget.percentUsed)) %>%"></div>
      </div>
      <% if (budget.overBudget) { %>
        <div class="cp-alert cp-alert-error cp-mt">Estimated spend has passed your monthly budget.</div>
      <% } else if (budget.alerting) { %>
        <div class="cp-alert cp-alert-warning cp-mt">Estimated spend has passed your <%= budget.alertPercent %>% alert threshold.</div>
      <% } %>
    <% } else { %>
      <p class="cp-secondary">No budget set. Chat Pilot will not warn you about AI spend until you set one.</p>
    <% } %>

    <p class="cp-help-text">
      The budget is a figure you choose. Chat Pilot never reads it from your provider account, and it is
      compared against Chat Pilot&rsquo;s estimate rather than a provider invoice.
    </p>
  </div>

  <form class="cp-card" method="post" action="/app/usage/budget">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h3 class="cp-card-title">Set your budget</h3>
    <div class="cp-form-group">
      <label class="cp-label" for="monthly_budget">Monthly budget (USD)</label>
      <input class="cp-input" type="number" step="0.01" min="0" id="monthly_budget" name="monthly_budget" value="<%= budget.budget.toFixed(2) %>">
      <p class="cp-help-text">Set 0 to turn budget tracking off.</p>
    </div>
    <div class="cp-form-group">
      <label class="cp-label" for="alert_percent">Warn me at</label>
      <input class="cp-input" type="number" min="1" max="100" id="alert_percent" name="alert_percent" value="<%= budget.alertPercent %>">
      <p class="cp-help-text">Percent of the budget. One alert per month per threshold.</p>
    </div>
    <button class="cp-btn cp-btn-primary" type="submit">Save budget</button>
  </form>
</div>

<div class="cp-card">
  <h3 class="cp-card-title">Monthly history</h3>
  <% if (!history.length) { %>
    <div class="cp-empty">No usage recorded yet.</div>
  <% } else { %>
    <div class="cp-table-wrap">
      <table class="cp-table">
        <thead><tr><th>Period</th><th>Messages</th><th>AI requests</th><th>Input</th><th>Output</th><th>Total tokens</th><th>Estimated cost</th></tr></thead>
        <tbody>
        <% history.forEach(function (h) { %>
          <tr>
            <td><%= h.period %></td>
            <td><%= h.messages.toLocaleString() %></td>
            <td><%= h.aiRequests.toLocaleString() %></td>
            <td><%= h.inputTokens.toLocaleString() %></td>
            <td><%= h.outputTokens.toLocaleString() %></td>
            <td><%= h.totalTokens.toLocaleString() %></td>
            <td>$<%= h.estimatedCost.toFixed(4) %></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/foot') %>
