<%- include('../partials/head') %>
<%- include('../partials/portal-header') %>
<div data-website-id="<%= website.id %>"></div>
<%- include('../partials/portal-tabs') %>

<% const b = analytics.budget || { monthlyBudget: 0, warningPct: 80, estimatedCost: 0, remainingBudget: 0, usagePct: 0, isUnlimited: true, isOverBudget: false, isWarning: false, exceededAmount: 0 }; %>

<% if (b.isOverBudget) { %>
  <div class="cp-alert cp-alert-error" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.4); border-radius:12px; padding:1rem 1.25rem;">
    <div style="display:flex; align-items:center; gap:0.75rem;">
      <span style="font-size:1.5rem;">🚨</span>
      <div>
        <strong style="color:#ef4444; font-size:0.95rem;">Budget Exceeded:</strong>
        <span style="color:#fca5a5; font-size:0.88rem;">Your estimated AI cost of <strong>$<%= analytics.estimatedCost.toFixed(4) %></strong> has exceeded your monthly budget of <strong>$<%= b.monthlyBudget.toFixed(2) %></strong> by $<%= b.exceededAmount.toFixed(2) %>.</span>
      </div>
    </div>
    <a href="#cp-budget-management" class="cp-btn cp-btn-sm" style="background:#dc2626; color:#ffffff; text-decoration:none; font-weight:600;">Manage Budget</a>
  </div>
<% } else if (b.isWarning) { %>
  <div class="cp-alert cp-alert-warning" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; background:rgba(245,158,11,0.15); border:1px solid rgba(245,158,11,0.4); border-radius:12px; padding:1rem 1.25rem;">
    <div style="display:flex; align-items:center; gap:0.75rem;">
      <span style="font-size:1.5rem;">⚠️</span>
      <div>
        <strong style="color:#f59e0b; font-size:0.95rem;">Budget Warning:</strong>
        <span style="color:#fde68a; font-size:0.88rem;">You have consumed <strong><%= b.usagePct %>%</strong> of your monthly AI budget ($<%= b.remainingBudget.toFixed(2) %> remaining of $<%= b.monthlyBudget.toFixed(2) %>).</span>
      </div>
    </div>
    <a href="#cp-budget-management" class="cp-btn cp-btn-sm" style="background:#d97706; color:#ffffff; text-decoration:none; font-weight:600;">Review Budget</a>
  </div>
<% } %>

<div class="cp-card">
  <h2 class="cp-card-title">
    Analytics <small><%= analytics.range.start %> to <%= analytics.range.end %></small>
    <span class="cp-actions-row">
      <% ['today','7days','30days','90days'].forEach(function (r) { %>
        <a class="cp-btn <%= preset === r ? 'cp-btn-primary' : 'cp-btn-secondary' %> cp-btn-sm" href="?range=<%= r %>"><%= r %></a>
      <% }); %>
      <a class="cp-btn cp-btn-secondary cp-btn-sm" href="analytics.csv?range=<%= preset %>">Export CSV</a>
    </span>
  </h2>

  <div class="cp-kpi-grid">
    <div class="cp-kpi-card"><div class="cp-kpi-icon">💬</div><div><div class="cp-kpi-value"><%= analytics.conversations %></div><div class="cp-kpi-label">Conversations</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">👤</div><div><div class="cp-kpi-value"><%= analytics.visitors %></div><div class="cp-kpi-label">Visitors</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">🎯</div><div><div class="cp-kpi-value"><%= analytics.leads %></div><div class="cp-kpi-label">Leads Captured</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">🤖</div><div><div class="cp-kpi-value"><%= analytics.aiRequests %></div><div class="cp-kpi-label">AI Requests</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">📥</div><div><div class="cp-kpi-value"><%= analytics.inputTokens.toLocaleString() %></div><div class="cp-kpi-label">Input Tokens</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">📤</div><div><div class="cp-kpi-value"><%= analytics.outputTokens.toLocaleString() %></div><div class="cp-kpi-label">Output Tokens</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">🔢</div><div><div class="cp-kpi-value"><%= analytics.totalTokens.toLocaleString() %></div><div class="cp-kpi-label">Total Tokens</div></div></div>
    <div class="cp-kpi-card"><div class="cp-kpi-icon">💵</div><div><div class="cp-kpi-value">$<%= analytics.estimatedCost.toFixed(4) %></div><div class="cp-kpi-label">Estimated AI Cost</div></div></div>
    
    <!-- Remaining Budget Card -->
    <div class="cp-kpi-card" style="border-color:<%= b.isOverBudget ? 'rgba(239,68,68,0.5)' : (b.isWarning ? 'rgba(245,158,11,0.5)' : 'rgba(16,185,129,0.3)') %>;">
      <div class="cp-kpi-icon"><%= b.isOverBudget ? '🚨' : (b.isWarning ? '⚠️' : '💳') %></div>
      <div style="flex:1;">
        <div class="cp-kpi-value" style="color:<%= b.isOverBudget ? '#ef4444' : (b.isWarning ? '#f59e0b' : '#10b981') %>;">
          <%= b.isUnlimited ? 'Unlimited' : '$' + b.remainingBudget.toFixed(2) %>
        </div>
        <div class="cp-kpi-label">Remaining Budget</div>
        <div style="margin-top:6px; background:rgba(255,255,255,0.08); height:6px; border-radius:3px; overflow:hidden;">
          <div style="width:<%= b.isUnlimited ? 0 : Math.min(100, b.usagePct) %>%; height:100%; background:<%= b.isOverBudget ? '#ef4444' : (b.isWarning ? '#f59e0b' : '#10b981') %>; transition:width 0.3s ease;"></div>
        </div>
        <div style="font-size:0.7rem; color:#94a3b8; margin-top:3px;">
          <%= b.isUnlimited ? 'Free Tier / No Spending Cap' : (b.isOverBudget ? 'Exceeded by $' + b.exceededAmount.toFixed(2) : b.usagePct + '% of $' + b.monthlyBudget.toFixed(2) + ' used') %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Interactive Usage & Token Graph Card -->
<div class="cp-card" style="margin-top:1.5rem;">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; margin-bottom:1rem;">
    <div>
      <h3 class="cp-card-title" style="margin:0 0 0.25rem 0;">📈 Usage & Token Trends</h3>
      <p style="font-size:0.8rem; color:#94a3b8; margin:0;">Daily telemetry across tokens, visitor engagement, and AI costs</p>
    </div>
    <div style="display:flex; gap:0.5rem; align-items:center;">
      <label for="cp-chart-metric-select" style="font-size:0.8rem; color:#94a3b8; font-weight:600;">Metric:</label>
      <select id="cp-chart-metric-select" class="cp-select" style="font-size:0.82rem; padding:0.35rem 0.75rem; width:auto; height:36px;">
        <option value="tokens" selected>🔢 Token Usage (Total)</option>
        <option value="conversations">💬 Conversations</option>
        <option value="leads">🎯 Leads Captured</option>
        <option value="ai_requests">🤖 AI Requests</option>
        <option value="cost">💵 Estimated Cost ($)</option>
      </select>
    </div>
  </div>

  <!-- SVG Chart Container -->
  <div id="cp-analytics-chart-container" style="width:100%; height:260px; position:relative; background:rgba(15,23,42,0.5); border-radius:12px; border:1px solid rgba(255,255,255,0.06); padding:1rem; box-sizing:border-box;">
    <!-- Rendered dynamically by analytics-chart.js -->
  </div>
</div>

<div class="cp-grid cp-grid-2">
  <div class="cp-card">
    <h3 class="cp-card-title">Answer quality</h3>
    <ul class="cp-inline-list">
      <li><span>Successful generations</span><span><%= analytics.successfulRequests %></span></li>
      <li><span>Missing-knowledge fallbacks</span><span><%= analytics.fallbackRequests %></span></li>
      <li><span>AI provider failures</span><span><%= analytics.providerErrors %></span></li>
      <li><span>Retrieval hit rate</span><span><%= analytics.retrievalHitRate %>%</span></li>
      <li><span>Average latency</span><span><%= analytics.avgLatencyMs %> ms</span></li>
    </ul>
    <p class="cp-help-text">
      Missing knowledge and provider failure are counted separately &mdash; a spike in one means something very
      different from a spike in the other.
    </p>
  </div>

  <div class="cp-card">
    <h3 class="cp-card-title">Provider / model breakdown</h3>
    <% if (!analytics.byModel.length) { %>
      <div class="cp-empty">No AI requests in this period.</div>
    <% } else { %>
      <div class="cp-table-wrap">
        <table class="cp-table" style="min-width:auto">
          <thead><tr><th>Provider</th><th>Model</th><th>Requests</th><th>Tokens</th><th>Cost</th></tr></thead>
          <tbody>
          <% analytics.byModel.forEach(function (m) { %>
            <tr><td><%= m.provider %></td><td><%= m.model %></td><td><%= m.requests %></td><td><%= m.tokens.toLocaleString() %></td><td>$<%= m.cost.toFixed(4) %></td></tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <% if (analytics.topErrors.length) { %>
    <div class="cp-card">
      <h3 class="cp-card-title">Provider error categories</h3>
      <ul class="cp-inline-list">
        <% analytics.topErrors.forEach(function (e) { %>
          <li><span><%= e.errorLabel %></span><span><%= e.count %></span></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <div class="cp-card">
    <h3 class="cp-card-title">Conversation sources</h3>
    <% if (!analytics.bySource.length) { %>
      <div class="cp-empty">No conversations in this period.</div>
    <% } else { %>
      <ul class="cp-inline-list">
        <% analytics.bySource.forEach(function (s) { %>
          <li><span><%= s.source === 'preview' ? 'Developer Preview' : 'Chat Widget' %></span><span><%= s.conversations %></span></li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</div>

<div class="cp-card">
  <h3 class="cp-card-title">Daily trend</h3>
  <% if (!analytics.trend.length) { %>
    <div class="cp-empty">No activity in this period.</div>
  <% } else { %>
    <% const maxTokens = Math.max.apply(null, analytics.trend.map(function (t) { return t.tokens; }).concat([1])); %>
    <div class="cp-table-wrap">
      <table class="cp-table">
        <thead><tr><th>Date</th><th>Conversations</th><th>Leads</th><th>AI requests</th><th>Tokens</th><th>Cost</th><th style="width:25%">Volume</th></tr></thead>
        <tbody>
        <% analytics.trend.forEach(function (t) { %>
          <tr>
            <td class="cp-nowrap"><%= t.date %></td>
            <td><%= t.conversations %></td>
            <td><%= t.leads %></td>
            <td><%= t.aiRequests %></td>
            <td><%= t.tokens.toLocaleString() %></td>
            <td>$<%= t.cost.toFixed(4) %></td>
            <td><div class="cp-bar"><div class="cp-bar-fill" style="width:<%= Math.round((t.tokens / maxTokens) * 100) %>%"></div></div></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Internal AI Budget Management Card -->
<div class="cp-card" id="cp-budget-management" style="margin-top:1.5rem;">
  <h3 class="cp-card-title">💳 Client AI Budget Management</h3>
  <p class="cp-description">
    Set a monthly spending limit and notification threshold for this website. Chat Pilot tracks token usage against standard model rates to calculate your remaining balance and display warning alerts.
  </p>
  <form data-ajax="/analytics/budget" data-success="Budget settings saved.">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:1.25rem; align-items:flex-end;">
      <div class="cp-form-group" style="margin-bottom:0;">
        <label class="cp-label" for="monthly_budget">Monthly AI Budget (USD)</label>
        <div style="position:relative;">
          <span style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; font-weight:600;">$</span>
          <input class="cp-input" type="number" step="0.01" min="0" max="100000" id="monthly_budget" name="monthly_budget" value="<%= (website.monthly_budget || 0).toFixed(2) %>" style="padding-left:1.8rem;">
        </div>
        <span style="font-size:0.75rem; color:#94a3b8; display:block; margin-top:4px;">Enter 0 for unlimited (no spending cap), or e.g. 20.00 for $20 budget.</span>
      </div>

      <div class="cp-form-group" style="margin-bottom:0;">
        <label class="cp-label" for="budget_warning_pct">Warning Alert Threshold</label>
        <select class="cp-select" id="budget_warning_pct" name="budget_warning_pct">
          <option value="70" <%= (website.budget_warning_pct === 70) ? 'selected' : '' %>>70% of Budget</option>
          <option value="80" <%= (!website.budget_warning_pct || website.budget_warning_pct === 80) ? 'selected' : '' %>>80% of Budget</option>
          <option value="90" <%= (website.budget_warning_pct === 90) ? 'selected' : '' %>>90% of Budget</option>
          <option value="100" <%= (website.budget_warning_pct === 100) ? 'selected' : '' %>>100% of Budget</option>
        </select>
        <span style="font-size:0.75rem; color:#94a3b8; display:block; margin-top:4px;">When remaining budget drops to this level, warning banners activate.</span>
      </div>

      <div>
        <button class="cp-btn cp-btn-primary" type="submit" style="height:42px;">Save Budget Settings</button>
      </div>
    </div>
  </form>
  <div style="margin-top:1rem; padding-top:0.75rem; border-top:1px solid rgba(255,255,255,0.06); font-size:0.78rem; color:#94a3b8; display:flex; align-items:center; gap:0.5rem;">
    <span>ℹ️</span>
    <span>Chat Pilot's internal budget tracks model token usage rates for this website. It acts as an internal safety limit and does not modify your live external credit card or OpenAI billing account.</span>
  </div>
</div>

<script id="cp-analytics-trend-data" type="application/json"><%- JSON.stringify(analytics.trend) %></script>

<%- include('../partials/foot', { pageScripts: ['/assets/js/analytics-chart.js'] }) %>
