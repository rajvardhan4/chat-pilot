<%- include('../partials/head') %>
<div class="cp-auth-wrap">
  <form class="cp-auth-card" method="post" action="/forgot-password">
    <div class="cp-logo"><span class="cp-logo-img" aria-hidden="true"></span><h1 class="cp-sr-only">Chat Pilot Cloud</h1></div>
    <% if (notice) { %><div class="cp-alert cp-alert-info"><%= notice %></div><% } %>
    <% if (error) { %><div class="cp-alert cp-alert-error">✕ <%= error %></div><% } %>
    <p class="cp-secondary">Enter your email address and we will send you a reset link.</p>
    <div class="cp-form-group">
      <label class="cp-label" for="email">Email address</label>
      <input class="cp-input" type="email" id="email" name="email" required autofocus>
    </div>
    <button class="cp-btn cp-btn-primary cp-btn-block" type="submit">Send reset link</button>
    <p class="cp-auth-foot"><a href="/login">Back to sign in</a></p>
  </form>
</div>
</body>
</html>
