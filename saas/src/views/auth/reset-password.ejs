<%- include('../partials/head') %>
<div class="cp-auth-wrap">
  <form class="cp-auth-card" method="post" action="/reset-password">
    <div class="cp-logo"><span class="cp-logo-img" aria-hidden="true"></span><h1 class="cp-sr-only">Chat Pilot Cloud</h1></div>
    <% if (error) { %><div class="cp-alert cp-alert-error">✕ <%= error %></div><% } %>
    <input type="hidden" name="token" value="<%= token %>">
    <div class="cp-form-group">
      <label class="cp-label" for="password">New password</label>
      <input class="cp-input" type="password" id="password" name="password" autocomplete="new-password" required autofocus>
      <p class="cp-help-text">At least 10 characters, including a number or symbol.</p>
    </div>
    <button class="cp-btn cp-btn-primary cp-btn-block" type="submit">Update password</button>
    <p class="cp-auth-foot"><a href="/login">Back to sign in</a></p>
  </form>
</div>
</body>
</html>
