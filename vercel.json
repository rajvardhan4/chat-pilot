{
  "version": 2,
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "saas/src/views/**",
        "saas/src/public/**",
        "src/views/**",
        "src/public/**"
      ]
    }
  }
}
