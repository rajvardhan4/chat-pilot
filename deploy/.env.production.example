# ---------------------------------------------------------------------------
# Chat Pilot Cloud - production .env
#
# Copy to saas/.env on the server, fill in the four marked values, and:
#   chmod 600 saas/.env
#
# Every value below is deliberate. The things that MUST change are marked
# CHANGE ME (APP_URL, MONGODB_URI, the three secrets, MAIL_FROM); the rest
# are correct as they stand for a single VPS behind nginx.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# CHANGE ME - the public HTTPS address of this install. Used in emails and in
# the dashboard links the WordPress plugin shows.
APP_URL=https://app.YOURDOMAIN.com

# CHANGE ME - your MongoDB Atlas connection string (Database Access user +
# Network Access entry for this server's IP must exist first). Atlas gives
# you this exact string from Database -> Connect -> Drivers.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name inside the cluster. Any name is fine; Atlas creates it on
# first write. Kept separate from the URI so one cluster can host more than
# one environment (staging/production) if you ever want that.
MONGODB_DB=chatpilot

# --- Secrets ---------------------------------------------------------------
# CHANGE ME - generate all three ON THE SERVER, once, and never again:
#   node -e "for (const k of ['ENCRYPTION_KEY','SESSION_SECRET','SITE_KEY_PEPPER']) console.log(k+'='+require('crypto').randomBytes(32).toString('hex'))"
#
# The app refuses to start in production without them, which is the point:
# a missing secret is a broken install, not a quiet fallback.
#
# ENCRYPTION_KEY decrypts every stored AI provider key.
# SITE_KEY_PEPPER verifies every Site API Key.
# Change either after go-live and every provider key becomes unreadable and
# every installed plugin disconnects at once. Back them up with the database.
ENCRYPTION_KEY=
SESSION_SECRET=
SITE_KEY_PEPPER=

# --- Behind nginx ----------------------------------------------------------
# Both of these must be true together. FORCE_HTTPS alone, with TRUST_PROXY off,
# makes the app see plain http behind TLS and redirect in a loop.
FORCE_HTTPS=true
TRUST_PROXY=true

# --- Rate limits -----------------------------------------------------------
# Per visitor, per window. Raise the chat limit only if real traffic hits it;
# it is also what stops one scripted visitor spending a client's AI credit.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_15MIN=10
RATE_LIMIT_API_PER_MINUTE=120

# --- Uploads ---------------------------------------------------------------
# Keep nginx's client_max_body_size above this, or nginx rejects the upload
# before the app can explain why.
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIR=./data/uploads

# --- AI providers ----------------------------------------------------------
PROVIDER_TIMEOUT_MS=20000

# --- Email -----------------------------------------------------------------
# 'log' records notifications in the database and the log instead of sending
# them. Nothing is lost; nothing is delivered either. Fine to launch with.
MAIL_TRANSPORT=log
# CHANGE ME
MAIL_FROM=no-reply@YOURDOMAIN.com

# --- Bootstrap admin -------------------------------------------------------
# Leave both empty. Create the master admin after the first start instead:
#   npm run admin:create -- --email you@yourdomain.com --name "Your Name"
# That way the password is never written to a file on disk.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
